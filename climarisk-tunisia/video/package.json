{
  "name": "climarisk-video",
  "private": true,
  "version": "0.1.0",
  "description": "Animated demo video for ClimaRisk Tunisie (Remotion). Figures come from ../outputs/kpis.json.",
  "scripts": {
    "props": "node scripts/make-props.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ClimaRisk out/climarisk_demo.mp4 --props=public/props.json --codec=h264 --browser-executable=$BROWSER_EXECUTABLE",
    "build": "npm run props && npm run render"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "remotion": "4.0.545",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "18.3.12"
  }
}
